# Copy to .env for local development. On Render, set these in the dashboard.
# Database (Render provides DATABASE_URL automatically when the database is linked)
DATABASE_URL=postgres://localhost:5432/fantasychess

# Server
PORT=3000
# Secret used to sign the player cookie. Set a long random value in production.
SESSION_SECRET=change-me-to-a-long-random-string

# PayPal (optional at first boot — the Store Owner Setup panel in the Shop tab
# can also save these, protected by OWNER_SETUP_TOKEN)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox

# Owner token required by POST /api/shop/config. If unset, the in-app setup
# panel is disabled and PayPal must be configured via environment variables.
# OWNER_SETUP_TOKEN=
